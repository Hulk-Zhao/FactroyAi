# Hogo-QA-tool 后端环境变量（复制为 .env 后按需修改；.env 不入库）
# 也可用真实环境变量注入（Docker compose 的 environment 段），两种方式等价。

# 监听端口
PORT=8788
# 监听地址：容器内必须 0.0.0.0
HOST=0.0.0.0

# 演示登录口令（防恶意刷访问；上线前请改成你自己的口令）
AUTH_PASSWORD=123

# 签发会话 token 的 HMAC 密钥。留空则首次启动自动生成并持久化到
# backend/data/runtime/auth-secret.key（重启不掉线）。
AUTH_SECRET=

# 会话有效期（小时）
TOKEN_TTL_HOURS=12

# 防刷限流：同一 IP 连续失败 RATE_MAX_FAILS 次后锁定 RATE_LOCK_MINUTES 分钟
RATE_MAX_FAILS=5
RATE_LOCK_MINUTES=10
# 登录失败时的固定延迟（毫秒），拖慢爆破
LOGIN_DELAY_MS=600

# 前端构建产物目录（SPA 静态托管 + history 回退）
STATIC_DIR=../frontend/dist-server
