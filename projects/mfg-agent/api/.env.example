# ============================================================
# 后端（广州）环境变量模板
#
# 复制为 .env 后填写。仓库是私有的，但 .env 仍不入库。
#
# 需要填两套 API：
#   1) QW_URL / QW_KEY   —— 阿里云百炼，**只用于向量模型**（text-embedding-v4）
#   2) DS_URL / DS_KEY   —— DeepSeek，**对话/分析/报告全部走这里**
# 另外必须填 AUTH_SECRET。
#
# 也兼容系统环境变量 qw_url / qw_key / ds_url / ds_key（大小写均可）。
# ============================================================

# ---------- 向量模型：Qwen MaaS（仅 embedding）----------
QW_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
QW_KEY=

# ---------- 对话模型：DeepSeek（所有 LLM 调用）----------
DS_URL=https://api.deepseek.com
DS_KEY=
# 只用 flash 快模型（L1/L2 一致），不使用 pro
DS_MODEL_L1=deepseek-flash
DS_MODEL_L2=deepseek-flash

# LLM 提供方：deepseek（默认）| ollama | qwen（仅显式切换时才用百炼对话）
LLM_PROVIDER=deepseek

# ---------- 云端 Embedding ----------
# DASHSCOPE_API_KEY 留空时自动回落到 QW_KEY，二者填一个即可
EMBEDDING_PROVIDER=dashscope
# dashscope = 原生 /services/embeddings/text-embedding/text-embedding
# openai   = 兼容模式 /embeddings（公共 DashScope 用这个）
EMBEDDING_API_STYLE=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_S=15
EMBEDDING_RETRIES=3
EMBEDDING_CACHE_SIZE=2048

# ---------- 云端重排（Qwen-Rerank，按次计费，失败自动回落 RRF）----------
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
# 留空则复用 DASHSCOPE_API_KEY / QW_KEY
RERANK_API_KEY=
RERANK_TIMEOUT_S=8
RERANK_RETRIES=1
# 送入重排的候选数（取 20 条左右即可，越大越贵）
RERANK_CANDIDATES=20

# ---------- 向量库（Chroma，本地持久化）----------
VECTOR_BACKEND=chroma
CASE_VECTOR_BACKEND=chroma
CHROMA_DIR=/app/data/chroma
CASE_CHROMA_DIR=/app/data/chroma_case

# ---------- 数据 ----------
# 只读种子在 /app/seed（镜像内），运行时数据在 /app/data（volume）
DB_URL=sqlite:////app/data/mfg_agent.db
WORKFLOW_DB=/app/data/mfg_agent.db
CASE_DB=/app/data/case.db
CASE_SEED_PATH=/app/seed/case_seed.json
KNOWLEDGE_DIR=/app/seed/knowledge
ENTERPRISE_KB_DIR=/app/seed/kbqa_corpus
MFG_DATA_DIR=/app/seed
# 首次启动：auto（索引空才写）/ force（全量重建）/ skip
SEED_MODE=auto

# ---------- 缓存 / 并发（Redis 由 docker-compose 内置）----------
# 多 worker 下 SSE 依赖 Redis Stream 跨进程广播；留空则退回单进程队列
REDIS_URL=redis://redis:6379/0
CACHE_TTL_S=600
RATE_LIMIT_PER_MIN=60
# uvicorn worker 数（多 worker 时 SSE 必须配 REDIS_URL；Chroma 本地索引注意文件锁）
UVICORN_WORKERS=2

# ---------- 认证 ----------
# 必须固定，否则每次重启所有令牌失效
AUTH_SECRET=
AUTH_TOKEN_TTL_S=28800

# 登录守卫（公网防刷）：默认开（验证码 + 账号口令）
# 前端登录流程 = 账号 admin + 密码 + 验证码 → 选择岗位身份
MFG_LOGIN_GUARD=1
MFG_ADMIN_USER=admin
MFG_ADMIN_PASS=123

# ---------- 制度检索（去 Reranker 后的排序参数）----------
KBQA_RECALL_TOP_K=24
KBQA_RRF_K=60
# 0=关闭；标定后再开（tools/calibrate_answer_thresholds.py）
KBQA_MIN_SCORE=0.0

# ---------- 演示开关（对外正式使用建议关闭）----------
CASE_DEMO_MODE=true
CASE_ACCESS_AUTO_APPROVE_DEMO=true
DATA_ACCESS_AUTO_APPROVE_DEMO=true

# ---------- 可选：本地开发挂前端 ----------
# FRONTEND_DIR=../frontend/public
