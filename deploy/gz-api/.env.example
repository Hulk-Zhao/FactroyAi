# ============================================================
# 广州单机部署环境变量模板
#
# 用法：
#   cp deploy/gz-api/.env.example deploy/gz-api/.env
#   按注释填写；.env 已被 .gitignore 覆盖，禁止入库。
#
# 本文件同时包含三部分：
#   1) 单机拓扑（域名 / CORS / 端口）——Nginx 与 compose 读取
#   2) mfg-agent FastAPI 变量——app 容器读取（与 projects/mfg-agent/api/.env.example 保持一致）
#   3) APS / Hogo 变量——对应容器读取
# ============================================================

# ---------- 单机拓扑 ----------
# API 子域：DNS A 记录指向 129.204.108.45
API_DOMAIN=api.hulkai.cn
# 站点主域：仅用于 api 根路径跳转
SITE_DOMAIN=hulkai.cn
# CORS 白名单（静态站 Origin）。多一个域名就多写一行 map，见 nginx 模板
SITE_ORIGIN_PRIMARY=https://hulkai.cn
SITE_ORIGIN_WWW=https://www.hulkai.cn
# api（含 443）| api.http（证书就绪前的 HTTP-only 冒烟）
NGINX_CONF=api

# 宿主机回环调试端口（不对公网开放）
MFG_HOST_PORT=8004
APS_BACKEND_PORT=8085

# ---------- 静态源站（灾备，默认关闭）----------
# 0 = 本机只做 API 网关，静态全部由 COS + CDN 提供（当前形态）
# 1 = 灾备：本机 Nginx 同时提供 hulkai.cn / www 静态文件，供 CDN 改回「自有源」时回源。
#     会占用本机 5Mbps 出口并与 API 抢带宽，只适合临时兜底；恢复后改回 0。
#     开启时证书必须是 hulkai.cn.pem / hulkai.cn.key，且覆盖 www.hulkai.cn。
SERVE_STATIC_ORIGIN=0
# 灾备静态根目录，只读挂载到容器 /srv/site
SITE_ROOT=/opt/hulkai/site

# ---------- 证书文件（放入 deploy/gz-api/certs/，不入库）----------
# api.hulkai.cn.pem / api.hulkai.cn.key  → api 网关（必需）
# hulkai.cn.pem     / hulkai.cn.key      → 灾备静态源站（可选，泛域名证书含 www SAN）
# 一张 *.hulkai.cn 泛域名证书可同时改名成上面两组使用。

# ---------- 镜像与构建 ----------
# 镜像仓库前缀：GitHub Actions 推送到 GHCR 后填写，必须全小写。
# 例：仓库 github.com/acme/factroy-ai → ghcr.io/acme/factroy-ai
REGISTRY=ghcr.io/your-github-name/your-repo
# 固定到某次 CI 产出的 commit tag（形如 sha-1a2b3c4），不要用 latest 上生产。
# 回滚时改成上一个可用的 sha-xxxxxxx，再 pull + up。
IMAGE_TAG=sha-0000000
# 国内构建直连 Maven Central 易被 TLS 中断，默认走阿里云公共仓库
APS_MAVEN_MIRROR_URL=https://maven.aliyun.com/repository/public
PIP_INDEX_URL=https://mirrors.cloud.tencent.com/pypi/simple

# ============================================================
# mfg-agent FastAPI（/api/*）
# 需要填两套 API：
#   QW_URL / QW_KEY —— 阿里云百炼，只用于向量模型（text-embedding-v4）
#   DS_URL / DS_KEY —— DeepSeek，对话/分析/报告
# 另外必须填 AUTH_SECRET。
# ============================================================

# ---------- 向量模型：Qwen MaaS（仅 embedding）----------
QW_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
QW_KEY=

# ---------- 对话模型：DeepSeek ----------
DS_URL=https://api.deepseek.com
DS_KEY=
DS_MODEL_L1=deepseek-flash
DS_MODEL_L2=deepseek-flash
LLM_PROVIDER=deepseek

# ---------- 云端 Embedding ----------
EMBEDDING_PROVIDER=dashscope
EMBEDDING_API_STYLE=dashscope
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10
EMBEDDING_TIMEOUT_S=15
EMBEDDING_RETRIES=3
EMBEDDING_CACHE_SIZE=2048

# ---------- 云端重排 ----------
RERANK_ENABLED=true
RERANK_MODEL=qwen3.7-text-rerank
RERANK_BASE_URL=https://cn-beijing.maas.qianwenaiapi.com/api/v1
RERANK_API_KEY=
RERANK_TIMEOUT_S=8
RERANK_RETRIES=1
RERANK_CANDIDATES=20

# ---------- 向量库 / 数据 ----------
VECTOR_BACKEND=chroma
CASE_VECTOR_BACKEND=chroma
CHROMA_DIR=/app/data/chroma
CASE_CHROMA_DIR=/app/data/chroma_case
DB_URL=sqlite:////app/data/mfg_agent.db
WORKFLOW_DB=/app/data/mfg_agent.db
CASE_DB=/app/data/case.db
CASE_SEED_PATH=/app/seed/case_seed.json
KNOWLEDGE_DIR=/app/seed/knowledge
ENTERPRISE_KB_DIR=/app/seed/kbqa_corpus
MFG_DATA_DIR=/app/seed
SEED_MODE=auto

# ---------- 缓存 / 并发 ----------
REDIS_URL=redis://redis:6379/0
CACHE_TTL_S=600
RATE_LIMIT_PER_MIN=60
UVICORN_WORKERS=2

# ---------- 认证（必须固定，否则每次重启令牌失效）----------
# 必填，留空会导致每次重启后旧登录态失效（表现为刚登录就 401）。
# 生成：openssl rand -hex 32
AUTH_SECRET=
AUTH_TOKEN_TTL_S=28800
MFG_LOGIN_GUARD=1
MFG_ADMIN_USER=admin
MFG_ADMIN_PASS=change-me

# ---------- 检索参数 ----------
KBQA_RECALL_TOP_K=24
KBQA_RRF_K=60
KBQA_MIN_SCORE=0.0

# ---------- 演示开关（正式对外建议关闭）----------
CASE_DEMO_MODE=true
CASE_ACCESS_AUTO_APPROVE_DEMO=true
DATA_ACCESS_AUTO_APPROVE_DEMO=true

# ============================================================
# 智能 APS 排产平台（/aps/*）
# ============================================================

# 复用已有数据卷（hulkai_aps_pgdata）时，下面三项必须与旧 PG 容器首次初始化时一致，
# 否则新容器连不上：password authentication failed / database "aps" does not exist。
# 读旧容器环境变量：docker inspect hulkai_aps_postgres-pre-switch \
#   --format '{{range .Config.Env}}{{println .}}{{end}}' | grep -E '^POSTGRES_(DB|USER|PASSWORD)='
APS_DB_NAME=aps
APS_DB_USER=aps
# 数据库口令：上线前必须改；卷首次初始化后不要再改（口令已固化在数据目录里，改了就连不上）
# 生成：openssl rand -hex 32
APS_DB_PASSWORD=change-me
APS_SECURITY_MODE=prod
# JWT 密钥：至少 32 字节随机串，上线前必须改
APS_SECURITY_JWT_SECRET=
APS_SECURITY_JWT_TTL_SECONDS=28800
# admin 首启口令（仅 dev profile 首次写入）；上线前必须改
APS_ADMIN_INIT_PASSWORD=change-me
# STOMP Origin 白名单：必须是浏览器地址栏的站点 Origin（不含路径）
APS_SECURITY_WS_ALLOWED_ORIGINS=https://hulkai.cn,https://www.hulkai.cn

# ============================================================
# Hogo-QA-tool（/hogo/api/*）
# ============================================================

# 演示口令（防刷门禁）；上线前必须改，不能保留 change-me
HOGO_AUTH_PASSWORD=change-me
# 留空则首次启动自动生成并持久化到卷 hulkai_hogo_runtime
HOGO_AUTH_SECRET=
