# 香港机器：只跑 Nginx + Hogo-QA-tool / APS 前端的 Node/静态服务。
# 用法：cp .env.example .env 后按需修改；.env 不入库。

# 对外主域名（当前临时使用 hulkai.xyz；备案通过后改成 hulkai.cn 即可切回）
PUBLIC_DOMAIN=hulkai.xyz
# 同时写入 server_name 的兼容域名（空格分隔）。主域名切换时无需改 Nginx 配置
PUBLIC_DOMAIN_ALIASES=hulkai.cn www.hulkai.cn www.hulkai.xyz
# 证书 lineage 目录名（certbot 首签 -d 的第一个域名）
CERT_DOMAIN=hulkai.xyz
# default（含 443，证书就绪后使用）| default.http（首签证书时的 HTTP-only）
NGINX_CONF=default

# APS 前端容器反代到广州 APS 后端的地址
APS_BACKEND_URL=http://129.204.108.45:8085

# Hogo-QA-tool 的演示口令（默认 123 仅供本地验证，公网部署必须改）
HOGO_AUTH_PASSWORD=change-me

# 可选：固定 HMAC 密钥（32 字节以上随机串）。留空则首次启动自动生成，
# 并持久化到卷 hulkai_hogo_runtime（容器重建后登录会话不失效）。
HOGO_AUTH_SECRET=
