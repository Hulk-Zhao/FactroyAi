# 首次签发证书专用的 HTTP-only 配置。
# 用法：NGINX_CONF=default.http docker compose up -d nginx
# 证书签发完成后再切回 default（含 443）。
server {
    listen 80;
    server_name ${PUBLIC_DOMAIN} ${PUBLIC_DOMAIN_ALIASES};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }
}
